# Copy to .env and fill in the values. The application reads all
# configuration from environment variables (a local .env is auto-loaded).

# GCP project used for Vertex AI calls (required)
GCP_PROJECT_ID=

# Vertex AI endpoint location
# GCP_LOCATION=global

# Gemini model used for reply generation
# GEMINI_MODEL=gemini-2.5-flash

# Logging level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Maximum accepted size of a single attachment in bytes
# MAX_ATTACHMENT_BYTES=15728640

# Web search tool (Brave). Key from https://api-dashboard.search.brave.com
# (Search plan; the free monthly credit covers this project's usage).
# Both values are needed to activate the tool; without them the chatbot
# answers from the email content alone.
# WEB_SEARCH_ENABLED=true
# BRAVE_API_KEY=
